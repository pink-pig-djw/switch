{
  "name": "switch-3d",
  "version": "1.0.0",
  "private": true,
  "description": "可交互的 Switch 风格掌机 3D 模型：Blender 程序化建模 + three.js 网页，可缩放查看细节并用键盘玩内置小游戏",
  "type": "module",
  "scripts": {
    "model": "python blender/build_switch.py",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
